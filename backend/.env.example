# Copy this file to .env and fill in real values. Never commit .env itself.

# Port the Express server listens on. The frontend's vite.config.js already
# proxies /api -> http://localhost:5000, so keep this at 5000 for local dev.
PORT=5000

# MongoDB connection string.
# Local MongoDB:      mongodb://127.0.0.1:27017/life-rpg
# MongoDB Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb+srv://tuplondhe05_db_user:X1dL3jx0Ht97A37v@dailyrpg.wvyeayk.mongodb.net/?appName=DailyRPG
# Secret used to sign JWTs. Use a long random string in real deployments.
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=30d

# Comma-separated list of origins allowed to call this API.
# The Vite dev server runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173
